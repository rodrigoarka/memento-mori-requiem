<div class="mm-app mm-item-app"><header class="mm-sheet-head"><div class="mm-brand"><b>MEMENTO MORI · RÉQUIEM</b><span>{{item.type}}</span></div><label>Nome<input name="name" value="{{item.name}}"></label></header><section class="mm-panel mm-item-grid">
  <label>Descrição / vínculo<textarea name="system.description" rows="4">{{system.description}}</textarea></label>
  {{#if isAnchor}}<label>Tipo de Âncora<select name="system.anchorType"><option value="pessoa" {{#if (eq system.anchorType 'pessoa')}}selected{{/if}}>Pessoa</option><option value="lugar" {{#if (eq system.anchorType 'lugar')}}selected{{/if}}>Lugar</option><option value="promessa" {{#if (eq system.anchorType 'promessa')}}selected{{/if}}>Promessa</option></select></label><p class="mm-hint">As flags Quebrada e Reclamada são atualizadas pela Ruptura; registrá-las manualmente pode afetar o balanceamento.</p><label><input type="checkbox" name="system.broken" {{#if system.broken}}checked{{/if}}> Quebrada</label><label><input type="checkbox" name="system.reclaimed" {{#if system.reclaimed}}checked{{/if}}> Reclamada</label>{{/if}}
  {{#if isSignature}}<label>Efeito uma vez por capítulo<textarea name="system.effect" rows="3">{{system.effect}}</textarea></label><label>Condição de ativação<textarea name="system.trigger">{{system.trigger}}</textarea></label>{{/if}}
  {{#if isLaw}}<label>Lei · Condição → Efeito<textarea name="system.law" rows="4">{{system.law}}</textarea></label><label>Exceção, aplicação ou limitação<textarea name="system.exception" rows="3">{{system.exception}}</textarea></label><label>Efeito da Interiorização<textarea name="system.effect">{{system.effect}}</textarea></label>{{/if}}
  {{#if isVerse}}<label>Região<input name="system.region" value="{{system.region}}"></label><label>Evidência observável<textarea name="system.evidence" rows="4">{{system.evidence}}</textarea></label>{{/if}}
  {{#if isCorrespondence}}<label>Sinal<textarea name="system.trigger">{{system.trigger}}</textarea></label><label>Lei<textarea name="system.law">{{system.law}}</textarea></label><label>Gesto<textarea name="system.gesture">{{system.gesture}}</textarea></label><label>Marco de Regresso<textarea name="system.returnMark">{{system.returnMark}}</textarea></label>{{/if}}
  {{#unless isLaw}}{{#unless isSignature}}{{#unless isVerse}}{{#unless isCorrespondence}}<label>Efeito / utilidade<textarea name="system.effect" rows="4">{{system.effect}}</textarea></label><label>Condição / encerramento<textarea name="system.condition" rows="3">{{system.condition}}</textarea></label>{{/unless}}{{/unless}}{{/unless}}{{/unless}}
  <label>Notas<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label>
</section></div>
