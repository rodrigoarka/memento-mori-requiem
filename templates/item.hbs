<div class="mm-app mm-item-app"><header class="mm-sheet-head"><div class="mm-brand"><b>MEMENTO MORI · RÉQUIEM</b><span>{{item.type}}</span></div><label>Nome<input name="name" value="{{item.name}}"></label></header><section class="mm-panel mm-item-grid">
  <label>Minha descrição<textarea name="system.description" rows="4">{{system.description}}</textarea></label>
  {{#if isAnchor}}<fieldset class="mm-anchor-kind"><legend>Tipo de Âncora</legend>
<label><input type="radio" name="system.anchorType" value="pessoa" {{#if (eq system.anchorType 'pessoa')}}checked{{/if}}>Pessoa</label>
<label><input type="radio" name="system.anchorType" value="lugar" {{#if (eq system.anchorType 'lugar')}}checked{{/if}}>Lugar</label>
<label><input type="radio" name="system.anchorType" value="promessa" {{#if (eq system.anchorType 'promessa')}}checked{{/if}}>Promessa</label>
</fieldset><p class="mm-hint">Situação: {{#if system.broken}}Âncora perdida{{else if system.reclaimed}}Âncora Reclamada{{else}}Âncora ativa{{/if}}. Mudanças de estado são resolvidas pela Ruptura.</p>{{/if}}
  {{#if isSignature}}<label>Efeito uma vez por capítulo<textarea name="system.effect" rows="3">{{system.effect}}</textarea></label><label>Condição de ativação<textarea name="system.trigger">{{system.trigger}}</textarea></label>{{/if}}
  {{#if isLaw}}<label>Lei · Condição → Efeito<textarea name="system.law" rows="4">{{system.law}}</textarea></label><label>Exceção, aplicação ou limitação<textarea name="system.exception" rows="3">{{system.exception}}</textarea></label>{{/if}}
  {{#if isVerse}}<label>Região<input name="system.region" value="{{system.region}}"></label><label>Lei relacionada (opcional)<input name="system.law" value="{{system.law}}"></label><label>Evidência observável<textarea name="system.evidence" rows="4">{{system.evidence}}</textarea></label>{{/if}}
  {{#if isCorrespondence}}<label>Sinal<textarea name="system.trigger">{{system.trigger}}</textarea></label><label>Lei<textarea name="system.law">{{system.law}}</textarea></label><label>Gesto<textarea name="system.gesture">{{system.gesture}}</textarea></label><label>Marco de Regresso<textarea name="system.returnMark">{{system.returnMark}}</textarea></label>{{/if}}
  {{#unless isLaw}}{{#unless isSignature}}{{#unless isVerse}}{{#unless isCorrespondence}}<label>Efeito / utilidade<textarea name="system.effect" rows="4">{{system.effect}}</textarea></label><label>Condição / encerramento<textarea name="system.condition" rows="3">{{system.condition}}</textarea></label>{{/unless}}{{/unless}}{{/unless}}{{/unless}}
  <label>Anotações livres<textarea name="system.notes" rows="5">{{system.notes}}</textarea></label>
</section></div>
