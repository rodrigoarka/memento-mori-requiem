<div class="mm-app">
  <header class="mm-sheet-head">
    <div class="mm-brand"><b>MEMENTO MORI · RÉQUIEM</b><span>Leve de jogar. Intenso de sentir.</span></div>
    <div class="mm-identity"><label>Nome<input type="text" name="name" value="{{actor.name}}"></label></div>
    <div class="mm-head-actions"><button type="button" data-action="rollWill">Vontade</button><button type="button" data-action="rollVoices" class="gold">Três Vozes</button></div>
  </header>
  {{#if isRetornado}}
    <nav class="mm-tabs">
      <button type="button" data-action="switchTab" data-tab="essencial" class="{{#if (eq tab 'essencial')}}active{{/if}}">Meu personagem</button>
      <button type="button" data-action="switchTab" data-tab="historia" class="{{#if (eq tab 'historia')}}active{{/if}}">Minhas anotações</button>
    </nav>
    {{#if (eq tab 'essencial')}}
      <section class="mm-columns">
        <div class="mm-panel">
          <label>Quem sou<input name="system.profession" value="{{system.profession}}" placeholder="Uma frase sobre o cotidiano"></label>
          <h2>Capacidades</h2>
          <div class="mm-abilities">
            <label>Lucidez<small>Compreender</small><input name="system.abilities.lucidez" type="number" min="0" max="2" value="{{system.abilities.lucidez}}"></label>
            <label>Pulso<small>Agir</small><input name="system.abilities.pulso" type="number" min="0" max="2" value="{{system.abilities.pulso}}"></label>
            <label>Elo<small>Relacionar</small><input name="system.abilities.elo" type="number" min="0" max="2" value="{{system.abilities.elo}}"></label>
            <label>Firmeza<small>Persistir</small><input name="system.abilities.firmeza" type="number" min="0" max="2" value="{{system.abilities.firmeza}}"></label>
          </div>
          <h2>Aptidões <button type="button" class="mm-add" data-action="createChild" data-type="aptidao">+ Nova</button></h2>
          {{#each aptidoes}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{else}}<p class="mm-empty">Escolha duas.</p>{{/each}}
          <h2>Assinaturas <button type="button" class="mm-add" data-action="createChild" data-type="assinatura">+ Nova</button></h2>
          {{#each assinaturas}}<div class="mm-entry"><div><strong>{{name}}</strong><small>{{system.effect}}</small></div><span><button type="button" data-action="signature" data-id="{{id}}">Usar</button><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></span></div>{{else}}<p class="mm-empty">Escolha uma.</p>{{/each}}
        </div>
        <div class="mm-panel">
          <h2>Âncoras <button type="button" class="mm-add" data-action="createChild" data-type="ancora">+ Nova</button></h2>
          {{#each ancoras}}
            <div class="mm-anchor {{#if system.broken}}broken{{/if}}">
              <div><strong>{{name}}</strong><small>{{#if system.broken}}Perdida{{else if system.reclaimed}}Reclamada{{else}}{{system.anchorType}}{{/if}}</small></div>
              <span><button type="button" data-action="recover" data-id="{{id}}" {{#if system.broken}}disabled{{/if}}>Cultivar</button><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></span>
            </div>
          {{else}}<p class="mm-empty">Uma pessoa, um lugar e uma promessa.</p>{{/each}}
          <h2>Distância <span class="mm-count">{{system.distance}} / 6</span></h2>
          <div class="mm-distance-bar" role="progressbar" aria-label="Distância" aria-valuemin="0" aria-valuemax="6" aria-valuenow="{{system.distance}}"><div class="mm-distance-fill" style="width:{{distancePercent}}%"></div></div>
          <div class="mm-buttons"><button type="button" data-action="alterDistance" data-delta="1">+1</button><button type="button" data-action="alterDistance" data-delta="-1">−1</button></div>
          {{#if (eq system.distance 5)}}<p class="mm-hint">Presságio: uma Âncora está ameaçada. Marque-a como preferir.</p>{{/if}}
          <h2>Luto <span class="mm-count">{{system.mourning}} / 3</span></h2>
          <div class="mm-luto-dots" role="group" aria-label="Luto, {{system.mourning}} de 3">{{#each (track 3 system.mourning)}}<span class="mm-luto-dot {{#if this}}filled{{/if}}"></span>{{/each}}</div>
          {{#if system.drift}}<div class="mm-warning">Deriva</div>{{/if}}
          {{#if system.rupture.active}}
          <div class="mm-danger"><b>Último Retorno · {{system.rupture.bell}}/3 Badaladas</b>
            <p>Âncora Reclamada: {{ruptureAnchor.name}}</p>
            <div class="mm-buttons"><button type="button" data-action="bell">Badalada</button><button type="button" data-action="saveAnchor">Salvar Âncora</button>{{#if isGM}}<button type="button" data-action="breakAnchor">Quebrar Âncora</button>{{/if}}</div>
          </div>{{/if}}
          <details class="mm-optional"><summary>Procedimentos, quando precisar</summary>
            <h2>Travessia</h2>
            <p class="mm-hint">{{#if system.journey.active}}No Limiar · estrato {{system.journey.deepest}}{{else}}Na Vigília{{/if}}</p>
            <div class="mm-buttons"><button type="button" data-action="journey" data-type="enter">Entrar</button><button type="button" data-action="journey" data-type="deepen">Aprofundar</button><button type="button" data-action="returnHome">Regressar</button></div>
            <p class="mm-hint">Recuperação neste capítulo: {{#if (eq system.recovery.chapter chapter)}}{{system.recovery.count}}{{else}}0{{/if}}/2 cenas.</p>
            <button type="button" data-action="transformation" {{#unless canTransform}}disabled{{/unless}}>Escolher Transformação{{#if canTransform}} disponível{{/if}}</button>
            <h2>Condições <button type="button" data-action="createChild" data-type="condicao">+ Nova</button></h2>
            {{#each condicoes}}<div class="mm-entry"><strong>{{name}}</strong><span><button type="button" data-action="editChild" data-id="{{id}}">Editar</button><button type="button" data-action="deleteChild" data-id="{{id}}">×</button></span></div>{{/each}}
          </details>
        </div>
      </section>
    {{/if}}
    {{#if (eq tab 'historia')}}
      <section class="mm-columns">
        <div class="mm-panel"><h2>Minhas anotações</h2><p class="mm-hint">Leis, dúvidas, lembranças e acontecimentos podem ficar aqui ou em qualquer outro lugar.</p><label>Escreva livremente<textarea name="system.notes" rows="18">{{system.notes}}</textarea></label></div>
        <div class="mm-panel">
          <details class="mm-optional"><summary>Informações da história, se quiser</summary>
            <label>Primeira Lembrança<textarea name="system.firstMemory" rows="4">{{system.firstMemory}}</textarea></label>
            <label>Impressão<textarea name="system.impression" rows="3">{{system.impression}}</textarea></label>
            <label>Incompletude<textarea name="system.incompleteness" rows="4">{{system.incompleteness}}</textarea></label>
            <label>Biografia<textarea name="system.biography" rows="5">{{system.biography}}</textarea></label>
            <label>Quem perceberá sua ausência?<textarea name="system.emptyPlace" rows="3">{{system.emptyPlace}}</textarea></label>
          </details>
          <details class="mm-optional"><summary>Descobertas estruturadas, se preferir</summary>
            <h2>Leis <button type="button" data-action="createChild" data-type="lei">+ Lei</button></h2>
            {{#each leis}}<div class="mm-entry"><strong>{{name}}</strong><span>{{#if (eq id ../system.interiorLawId)}}<button type="button" data-action="interiorize" data-id="{{id}}">Usar</button>{{/if}}<button type="button" data-action="editChild" data-id="{{id}}">Editar</button></span></div>{{/each}}
            <h2>Versos <button type="button" data-action="createChild" data-type="verso">+ Verso</button></h2>
            {{#each versos}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
            <button type="button" data-action="stanza">Compor Estrofe</button>
            <h2>Correspondências <button type="button" data-action="createChild" data-type="correspondencia">+ Nova</button></h2>
            {{#each correspondencias}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
            <h2>Equipamento <button type="button" data-action="createChild" data-type="equipamento">+ Novo</button></h2>
            {{#each equipamentos}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
          </details>
        </div>
      </section>
    {{/if}}
  {{/if}}

  {{#if isConfluencia}}
  <section class="mm-columns">
    <div class="mm-panel">
      <h2>Confluência</h2>
      <label>Verso Comum<textarea name="system.commonVerse" rows="4">{{system.commonVerse}}</textarea></label>
      <label>Quem participa<input name="system.members" value="{{system.members}}"></label>
      <p class="mm-hint">{{#if unusedOpportunity}}Oportunidade coletiva disponível{{else}}Oportunidade coletiva utilizada neste capítulo{{/if}}</p>
      <button type="button" data-action="rastro">Rastro Compartilhado</button>
      <p class="mm-hint">Sincronia é escolhida na Ressonância. As duas opções compartilham uma oportunidade por capítulo.</p>
      <label>Notas livres<textarea name="system.notes" rows="8">{{system.notes}}</textarea></label>
    </div>
    <div class="mm-panel">
      <details class="mm-optional"><summary>Descobertas e caminhos, se precisar</summary>
        <h2>Leis <button type="button" data-action="createChild" data-type="lei">+ Lei</button></h2>
        {{#each leis}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
        <h2>Versos <button type="button" data-action="createChild" data-type="verso">+ Verso</button></h2>
        {{#each versos}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
        <button type="button" data-action="stanza">Compor Estrofe</button>
        <label>Caminhos<textarea name="system.routes" rows="4">{{system.routes}}</textarea></label>
        <label>Último Rastro<textarea name="system.lastTrail" rows="3">{{system.lastTrail}}</textarea></label>
      </details>
    </div>
  </section>{{/if}}

  {{#if isEntidade}}
  <section class="mm-columns">
    <div class="mm-panel"><h2>Entidade · três perguntas</h2>
      <label>O que deseja?<textarea name="system.intention">{{system.intention}}</textarea></label>
      <label>Como age?<textarea name="system.nature">{{system.nature}}</textarea></label>
      <label>Como lidar com ela?<textarea name="system.approaches">{{system.approaches}}</textarea></label>
      <label>Notas livres<textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
    </div>
    <div class="mm-panel"><details class="mm-optional"><summary>Se esta entidade pedir mais detalhes</summary>
      <label>Lei própria (opcional)<textarea name="system.law">{{system.law}}</textarea></label>
      <label>Limite<textarea name="system.limitation">{{system.limitation}}</textarea></label>
      <label>Sinais<textarea name="system.signs">{{system.signs}}</textarea></label>
      <label>Consequência<textarea name="system.consequence">{{system.consequence}}</textarea></label>
      {{> "systems/memento-mori-requiem/templates/pressure.hbs"}}
    </details></div>
  </section>{{/if}}

  {{#if isDominio}}
  <section class="mm-columns">
    <div class="mm-panel"><h2>Domínio · cinco ideias</h2>
      <label>Lugar<textarea name="system.appearance">{{system.appearance}}</textarea></label>
      <label>Estranheza<textarea name="system.signals">{{system.signals}}</textarea></label>
      <label>Lei · condição e efeito<textarea name="system.law">{{system.law}}</textarea></label>
      <label>Complicação<textarea name="system.opposition">{{system.opposition}}</textarea></label>
      <label>Saída / Marco de Regresso<textarea name="system.returnMark">{{system.returnMark}}</textarea></label>
      <label>Notas livres<textarea name="system.notes" rows="5">{{system.notes}}</textarea></label>
    </div>
    <div class="mm-panel"><details class="mm-optional"><summary>Outras ideias, se forem necessárias</summary>
      <label>Objetivo do grupo<textarea name="system.objective">{{system.objective}}</textarea></label>
      <label>Exceção investigável<textarea name="system.exception">{{system.exception}}</textarea></label>
      <label>Preço ou limitação<textarea name="system.cost">{{system.cost}}</textarea></label>
      <label>Rotas<textarea name="system.routes">{{system.routes}}</textarea></label>
      <h2>Três Vozes, inspirações</h2>
      <label>Corpo<textarea name="system.matrixBody">{{system.matrixBody}}</textarea></label>
      <label>Memória<textarea name="system.matrixMemory">{{system.matrixMemory}}</textarea></label>
      <label>Véu<textarea name="system.matrixVeil">{{system.matrixVeil}}</textarea></label>
      {{> "systems/memento-mori-requiem/templates/pressure.hbs"}}
      <h2>Leis <button type="button" data-action="createChild" data-type="lei">+ Lei</button></h2>
      {{#each leis}}<div class="mm-entry"><strong>{{name}}</strong><span><button type="button" data-action="editChild" data-id="{{id}}">Editar</button>{{#if ../isGM}}<button type="button" data-action="shareLaw" data-id="{{id}}">Compartilhar</button>{{/if}}</span></div>{{/each}}
      <h2>Versos <button type="button" data-action="createChild" data-type="verso">+ Verso</button></h2>
      {{#each versos}}<div class="mm-entry"><strong>{{name}}</strong><button type="button" data-action="editChild" data-id="{{id}}">Editar</button></div>{{/each}}
      <button type="button" data-action="stanza">Compor Estrofe</button>
    </details></div>
  </section>{{/if}}

  {{#if isFissura}}
  <section class="mm-columns">
    <div class="mm-panel"><h2>Fissura</h2>
      <label>Origem<textarea name="system.origin">{{system.origin}}</textarea></label>
      <label>Sinais<textarea name="system.signs">{{system.signs}}</textarea></label>
      <label>Notas livres<textarea name="system.notes" rows="8">{{system.notes}}</textarea></label>
      <details class="mm-optional"><summary>Escalada preparada, se precisar</summary>
        <label>1 · Vestígio<textarea name="system.vestige">{{system.vestige}}</textarea></label>
        <label>2 · Manifestação<textarea name="system.manifestation">{{system.manifestation}}</textarea></label>
        <label>3 · Invasão<textarea name="system.invasion">{{system.invasion}}</textarea></label>
        <label>4 · Concretização<textarea name="system.concretization">{{system.concretization}}</textarea></label>
      </details>
    </div>
    <div class="mm-panel">
      <h2>Estágio {{system.stage}} / 4</h2>
      <div class="mm-track">{{#each (track 4 system.stage)}}<span class="{{#if this}}filled{{/if}}"></span>{{/each}}</div>
      <div class="mm-buttons"><button type="button" data-action="fissureChange" data-delta="-1" {{#unless isGM}}disabled{{/unless}}>Recuar</button><button type="button" data-action="fissureChange" data-delta="1" {{#unless isGM}}disabled{{/unless}}>Avançar</button></div>
      <label><input type="checkbox" name="system.active" {{#if system.active}}checked{{/if}}> Ativa</label>
      <label><input type="checkbox" name="system.contained" {{#if system.contained}}checked{{/if}}> Contida</label>
      <p class="mm-hint">No máximo um avanço por capítulo, se a causa estiver ativa e sem contenção.</p>
    </div>
  </section>{{/if}}
</div>